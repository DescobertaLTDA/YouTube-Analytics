# Supabase — projeto "YouTube Analytics" (ildxajnvgoduikxkcxqv)
NEXT_PUBLIC_SUPABASE_URL=https://ildxajnvgoduikxkcxqv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_anon_key
# Só usada em Edge Functions / server-side, nunca exposta ao browser:
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_key

# YouTube Data API v3 — usada pela Edge Function de coleta diária e pela
# aba "Ganhos" (varredura do canal por hashtag)
