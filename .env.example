# Canal usado na aba "Ganhos" pra achar os vídeos com #lucas / #matheus /
# #rafael. Já tem um valor padrão no código (UCJWArKWSlKLzTOekfIHxOHw),
# só precisa preencher se for usar outro canal.
YOUTUBE_CHANNEL_ID=UCJWArKWSlKLzTOekfIHxOHw
